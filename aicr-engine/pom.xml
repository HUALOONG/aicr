<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.joyintech</groupId>
        <artifactId>aicr-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>aicr-engine</artifactId>
    <packaging>jar</packaging>
    <name>aicr-engine</name>
    <description>后台引擎层：智能分析、结果回写、大变更策略、反馈闭环（FR-022~026）</description>

    <dependencies>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>aicr-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>aicr-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>aicr-base</artifactId>
        </dependency>
        <dependency>
            <groupId>com.joyintech</groupId>
            <artifactId>aicr-security</artifactId>
        </dependency>

        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 红线一：engine 禁止依赖 service（HLD §2.4.3） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-service</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.joyintech:aicr-service</exclude>
                                    </excludes>
                                    <message>engine 禁止依赖 service（HLD §2.4.3 红线一）</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
